# Copy to .env — never commit real keys. This project runs fully offline on the mock gateway.
LLM_PROVIDER=mock
MOCK_MODEL=mock-explainer-1
MAX_USD_PER_RUN=5.0
ASSESSMENT_BUDGET_USD=0.50
HIGH_RISK_THRESHOLD=35.0
REJECT_THRESHOLD=65.0
FN_COST=10.0
FP_COST=1.0
FREEZE_WINDOWS=["2024-12-20:2025-01-05"]
DATA_PATH=data/history.jsonl
